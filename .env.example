# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
# O Spring Boot lê o .env automaticamente (spring.config.import em application.properties)
# e variáveis de ambiente reais têm precedência sobre os valores daqui.
#
# Formato .properties: NÃO use aspas ("..." ou '...') nem espaços ao redor dos valores.
# Referência completa: docs/CONFIGURACAO.md

# === Banco de dados ===
# DB_URL e DB_USERNAME têm padrão local; DB_PASSWORD é obrigatório.
DB_URL=jdbc:postgresql://localhost:5432/valhalla
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# === Segurança (JWT) ===
# Obrigatório: Base64 com pelo menos 32 bytes (256 bits), diferente por ambiente.
# Gere com: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
# Ou com: $b = New-Object byte[] 32; [System.Security.Cryptography.RNGCryptoServiceProvider]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
# Durações no formato ISO-8601. Padrões: access PT1H, refresh P7D.
JWT_EXPIRATION=PT1H
JWT_REFRESH_EXPIRATION=P7D

# === CORS e cookies ===
# Uma ou mais origens separadas por vírgula, sem barra final.
FRONTEND_URL=http://localhost:5173
# true em produção (cookies só via HTTPS). O perfil dev força false.
COOKIE_SECURE=false

# === Perfil do Spring Boot ===
# Dentro do .env use o nome canônico em minúsculas. Exportado como variável de
# ambiente do processo, use SPRING_PROFILES_ACTIVE.
# O perfil dev aplica db/demo (dados de demonstração) e libera cookies sem HTTPS.
# spring.profiles.active=dev

# === Logs (opcionais, lidos diretamente pelo Logback) ===
# LOG_PATH=logs
# LOG_LEVEL_APP=INFO
# LOG_HISTORY_DAYS=30
# LOG_TOTAL_SIZE_CAP=1GB
# LOG_FILE_MAX_SIZE=25MB
